# Copie para .env (que nunca vai para o Git) só se precisar mudar algum padrão.
# Sem essas variáveis, o serviço usa os valores padrão do application.yml (localhost).

SERVER_PORT=8099
DB_URL=jdbc:postgresql://localhost:5432/exemplo_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
EUREKA_URL=http://localhost:8761/eureka
